# Copie este archivo como .env únicamente si su método de ejecución lo requiere.
# Reemplace el valor por una clave propia y no publique el archivo .env.
DJANGO_SECRET_KEY=reemplace-por-una-clave-local-propia
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DB_PATH=
DJANGO_MEDIA_ROOT=
DJANGO_STATIC_ROOT=
DATA_TRANSFER_WORK_ROOT=
DATA_TRANSFER_MAX_PACKAGE_BYTES=67108864
DATA_TRANSFER_MAX_FILES=500
DATA_TRANSFER_MAX_UNCOMPRESSED_BYTES=134217728
DATA_TRANSFER_RETENTION=10
